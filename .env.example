# Settings for the dashboard. Nothing is needed in the usual setup, where the backend
# (scraper-backend) serves this dashboard itself: leave everything empty.
#
# Only when the dashboard is hosted on its own (e.g. Vercel): copy this file to .env.local, or enter
# the same names in the host's environment settings. They are read when the dashboard is built
# (npm run build), so rebuild after changing them.

# The backend's address, without /api at the end.
# Example: NEXT_PUBLIC_API_URL=https://scraper-backend.onrender.com
NEXT_PUBLIC_API_URL=

# The backend must then allow this dashboard's address: add it to the backend's CORS_ORIGINS.
# The backend's DASHBOARD_PASSWORD login works only when the backend serves the dashboard itself.
