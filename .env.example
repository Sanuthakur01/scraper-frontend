# Settings for the dashboard. Copy this file to .env.local (or enter the same names in the host's
# environment settings, e.g. Vercel). They are read when the dashboard is built (npm run build), so
# rebuild after changing them.

# Sign-in (required): the Clerk application's publishable key (Clerk dashboard → API keys). It is
# public by design and ends up in the browser. Only users whose Clerk public metadata has
# { "role": "SUPER_ADMIN" | "ADMIN" | "PLACEMENT_STAFF" | "RESEARCH_TEAM" } can use the dashboard
# (see lib/access.ts). Without it the dashboard shows "Sign-in isn't set up".
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# The dashboard is static files, so it never uses Clerk's secret key: don't put CLERK_SECRET_KEY in a
# host's settings for this dashboard, and never give it a NEXT_PUBLIC_ name (that would publish it).

# The rest is only needed when the dashboard is hosted on its own. In the usual setup, where the
# backend (scraper-backend) serves this dashboard itself, leave it empty.
#
# The backend's address, without /api at the end.
# Example: NEXT_PUBLIC_API_URL=https://scraper-backend.onrender.com
NEXT_PUBLIC_API_URL=

# The backend must then allow this dashboard's address: add it to the backend's CORS_ORIGINS.
# The backend's DASHBOARD_PASSWORD login works only when the backend serves the dashboard itself.
